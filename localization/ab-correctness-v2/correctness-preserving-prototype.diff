+/**
+ * begin_parallel_cpu_context
+ * @cs: the CPU context
+ *
+ * Called before creating the second CPU in this process.  Shared memory can
+ * require parallel code generation without there being another local CPU.
+ */
+static inline void begin_parallel_cpu_context(CPUState *cs)
+{
+    if (!tcg_cflags_has(cs, CF_MULTI_CPU)) {
+        bool was_parallel = tcg_cflags_has(cs, CF_PARALLEL);
+
+        /*
+         * A shared mapping may already have enabled CF_PARALLEL.  In that
+         * case this CPU is no longer considered a serial context, so enter
+         * an exclusive section before flushing translations generated
+         * without CF_MULTI_CPU.
+         */
+        if (was_parallel) {
+            start_exclusive();
+        }
+        tb_flush__exclusive_or_serial();
+        tcg_cflags_set(cs, CF_PARALLEL | CF_MULTI_CPU);
+        if (was_parallel) {
+            end_exclusive();
+        }
+    }
+}
